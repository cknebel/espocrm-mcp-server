{
  "name": "espocrm-mcp-server",
  "version": "0.4.0",
  "private": true,
  "description": "Allowlist-based MCP server for EspoCRM records, including writable Meetings, Calls and Tasks.",
  "type": "module",
  "bin": {
    "espocrm-mcp-server": "dist/index.js",
    "espocrm-mcp-http-server": "dist/http.js"
  },
  "files": [
    "dist",
    "config/permissions.example.yaml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
