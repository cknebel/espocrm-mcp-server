ESPOCRM_URL=https://crm.example.de
ESPOCRM_API_KEY=replace-me
# Optional. Defaults to config/permissions.example.yaml.
ESPOCRM_PERMISSIONS_FILE=config/permissions.example.yaml
# Optional. Audit entries contain metadata only, never record contents.
ESPOCRM_AUDIT_LOG=logs/audit.jsonl

# Optional HTTP transport for remote MCP via a TLS reverse proxy such as Caddy.
# Bind to localhost by default so the Node process is not publicly reachable.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
# Bearer token expected by the Caddyfile examples in README.md.
# This value must be available to the Caddy process, not only to this MCP container.
# ESPOCRM_MCP_BEARER_TOKEN=replace-with-a-long-random-token
# Optional second layer checked by the Node MCP server itself.
# If both Caddy and Node should check the same Authorization header, set this
# to the same value as ESPOCRM_MCP_BEARER_TOKEN.
# MCP_HTTP_BEARER_TOKEN=replace-with-the-same-long-random-token
# Required when MCP_HTTP_HOST is 0.0.0.0 or when Caddy forwards a public Host header.
# Comma-separated host names that the MCP transport accepts.
# MCP_HTTP_ALLOWED_HOSTS=espocrm-mcp.example.de,127.0.0.1
# Optional comma-separated browser origins for DNS-rebinding protection.
# MCP_HTTP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai
